rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/wods/{wodId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    match /communityWods/{wodId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'commentCount'])
      );
      
      // === MESSAGES SUBCOLLECTION - CORRECTED ===
      match /messages/{messageId} {
        // Temporary rule to unblock the current permission issue.
        allow read: if true; 
       
        allow create: if isSignedIn()
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.text.size() <= 280;

        allow update: if isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['upvotes', 'downvotes', 'score', 'replyCount']);
        allow delete: if false;
      }
      // === REACTORS SUBCOLLECTION - CORRECTED ===
      match /reactors/{reactorId} {
        allow get: if isSignedIn();
        allow create, update, delete: if isSignedIn() && request.auth.uid == reactorId;
      }
    }
    match /hallOfFame/{userId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
