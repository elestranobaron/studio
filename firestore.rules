
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // USERS
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    // WODs PERSONNELS
    match /users/{userId}/wods/{wodId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // COMMUNITY WODs
    match /communityWods/{wodId} {
      allow read: if isSignedIn() || get(/databases/$(database)/documents/communityWods/$(wodId)).data.userId == 'system';
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Allow updates for reaction counts
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'commentCount']))
      );

      match /reactors/{reactorId} {
        allow read, create, delete: if isSignedIn() && (isOwner(reactorId) || request.auth.uid == reactorId);
      }

      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() 
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.text.size() <= 280;
        allow update: if isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes', 'score']);
        allow delete: if false; 
      }
    }

    // HALL OF FAME
    match /hallOfFame/{userId} {
      allow read: if true; // Publicly readable
      allow write: if false; // Only backend can write
    }
  }
}
