
{
  "hosting": {
    "target": "app",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Link",
            "value": "<https://wodburner.app{uri}>; rel=\"canonical\""
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "wodburner.app"
    ]
  },
  "functions": 
    {

      "source": "src/functions",

      "codebase": "functions",

      "runtime": "nodejs20",
      "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "env": [
      {
        "dotenv": "src/functions/.env"
      }
    ],
    "functions": {
      "verifyDigicode": {
        "entryPoint": "verifyDigicode"
      },
      "sendDigicode": {
        "entryPoint": "sendDigicode"
      },
      "createCheckout": {
        "entryPoint": "createCheckout"
      },
      "createCustomerPortal": {
        "entryPoint": "createCustomerPortal"
      }
    }
    }

  
}
